# Copia este archivo como .streamlit/secrets.toml en local, o pega su contenido
# (con tus valores reales) en Streamlit Cloud -> Settings -> Secrets.
# NUNCA subas secrets.toml con valores reales a este repositorio.

# --- Base de datos (Amazon DynamoDB) y fotos (Amazon S3) ---
# Las tablas y el bucket los crea `infra/` (CDK); aqui solo se dice COMO
# llamarlos y en que Region. Las CREDENCIALES de AWS (quien puede escribir en
# esas tablas/ese bucket) NO van en este archivo:
#   - Streamlit Community Cloud (fuera de AWS, no hay rol de IAM que asumir):
#     agrega ADEMAS AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY aqui, de un
#     usuario/credencial de AWS con permisos SOLO sobre estas tablas y este
#     bucket (ver infra/README.md). Streamlit Cloud expone estos secretos
#     tambien como variables de entorno del proceso, que es de donde los lee
#     boto3 automaticamente.
#   - Local o en AWS (ECS Fargate): NO pongas claves aqui. Usa
#     `aws configure`/`aws login` (local) o el rol de la tarea de ECS
#     (produccion) -- boto3 las encuentra solo, sin que este archivo las
#     mencione.
AWS_REGION = "us-east-1"                        # la Region asignada a tu proyecto (ver AWS Settings)
DYNAMODB_TABLE_PREFIX = "uniminuto-lab"          # debe coincidir con infra/ (nombre de cada tabla)
PHOTOS_S3_BUCKET = "uniminuto-lab-inventory-123456789012"  # nombre real del bucket (incluye tu Account ID)
# PHOTOS_S3_PREFIX = "fotos"                     # opcional, por defecto "fotos"
# AWS_ACCESS_KEY_ID = "solo-si-despliegas-en-streamlit-community-cloud"
# AWS_SECRET_ACCESS_KEY = "solo-si-despliegas-en-streamlit-community-cloud"

# --- Cuenta maestra inicial (se crea automaticamente al primer arranque) ---
MASTER_EMAIL = "admin@uniminuto.edu.co"
MASTER_INITIAL_PASSWORD = "cambia-esta-clave-apenas-inicies-sesion"

# El registro acepta cualquier correo institucional (dominio terminado en
# .edu o .edu.co); no requiere configuracion adicional.

# --- Alertas por WhatsApp (opcional, Twilio) ---
# TWILIO_ACCOUNT_SID = ""
# TWILIO_AUTH_TOKEN = ""
# TWILIO_WHATSAPP_FROM_NUMBER = ""
# DESTINATION_WHATSAPP_NUMBER = ""
# --- Correo automático para solicitudes y reservas (opcional) ---
# Si ADMIN_NOTIFICATION_EMAILS queda vacío, la app usa los correos de los
# usuarios activos con rol profesor o maestro.
ADMIN_NOTIFICATION_EMAILS = ["administrador@uniminuto.edu.co"]
SMTP_HOST = "smtp.office365.com"
SMTP_PORT = 587
SMTP_USERNAME = "notificaciones@uniminuto.edu.co"
SMTP_PASSWORD = "configura-esta-clave-solo-en-streamlit-secrets"
SMTP_FROM_EMAIL = "notificaciones@uniminuto.edu.co"
SMTP_USE_TLS = true
SMTP_USE_SSL = false
# Opcional: enlace a la app dentro de cada correo.
# APP_URL = "https://tu-app.streamlit.app"

# --- Seguridad y sesión ---
# Secreto independiente de NFC_SECRET. Sin él, F5 conserva el comportamiento
# anterior y pide iniciar sesión de nuevo.
# SESSION_SECRET = "genera-una-frase-aleatoria-larga-y-distinta"
# SESSION_IDLE_MINUTES = 30       # vencimiento deslizante por inactividad
# SESSION_MAX_HOURS = 12          # tope absoluto
# SESSION_TAB_CLOSE_GRACE_SECONDS = 0  # heartbeat opcional; 0 = apagado
# LOGIN_MAX_ATTEMPTS = 5          # intentos fallidos antes de bloquear un correo
# LOGIN_LOCKOUT_MINUTES = 5       # duracion del bloqueo
# SESSION_TIMEOUT_MINUTES = 720   # sin SESSION_SECRET: la sesion expira a las 12 horas

# --- Actualización y despacho ---
# (SYNC_MODE/SYNC_DEFER_SECONDS/SYNC_RETRY_SECONDS ya no aplican: DynamoDB no
# tiene el concepto de "publicar despues"; cada escritura ya es consistente.)
# ALLOW_SELF_APPROVAL = false     # true: quien revisa puede aprobar su propia solicitud (solo demostraciones)
# DATA_POLL_SECONDS = 60
# DISPATCH_REFRESH_SECONDS = 5
# LIST_REFRESH_SECONDS = 15
# STUCK_MINUTES = 30
# AUTO_APPROVE_PRODUCT_REQUESTS = false

# --- Chips NFC (opcional) ---
# Direccion publica de la app: es la que se graba en cada chip.
# APP_URL = "https://mi-laboratorio.streamlit.app"
# Secreto para firmar las URL de los chips (configuralo ANTES de grabarlos;
# si lo cambias, hay que regrabar los chips). Sin el, las URL van sin firma.
# NFC_SECRET = "una-frase-larga-y-secreta"
